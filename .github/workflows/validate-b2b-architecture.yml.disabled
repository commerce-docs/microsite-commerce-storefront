name: Validate B2B Branch Architecture

on:
  pull_request:
    branches:
      - 'releases/b2b-infrastructure'
      - 'releases/b2b-docs-only'
      - 'b2b-docs-**'
      - 'b2b-documentation'
  push:
    branches:
      - 'releases/b2b-infrastructure'
      - 'releases/b2b-docs-only'
      - 'b2b-docs-**'
      - 'b2b-documentation'

jobs:
  validate-architecture:
    name: Validate Branch Content
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # Need full history for validation
      
      - name: Make validation script executable
        run: chmod +x scripts/validate-branch-content.sh
      
      - name: Run branch content validation
        run: ./scripts/validate-branch-content.sh
      
      - name: Install Node.js
        if: success() || failure()  # Run even if previous step failed
        uses: actions/setup-node@v4
        with:
          node-version: '20'
      
      - name: Install dependencies
        if: success() || failure()
        run: npm ci --legacy-peer-deps || npm install --legacy-peer-deps
      
      - name: Validate B2B enrichments
        if: success() || failure()
        run: |
          # Only run if enrichments exist in this branch
          if [ -d "_dropin-enrichments" ] && [ "$(ls -A _dropin-enrichments 2>/dev/null)" ]; then
            npm run validate-b2b-enrichments || {
              echo "❌ Enrichment validation failed"
              echo "Run locally: npm run validate-b2b-enrichments --fix"
              exit 1
            }
          else
            echo "ℹ️  No enrichments in this branch (expected for infrastructure-only)"
          fi
      
      - name: Check for merge direction violations
        if: github.event_name == 'pull_request'
        run: |
          BASE_BRANCH="${{ github.base_ref }}"
          HEAD_BRANCH="${{ github.head_ref }}"
          
          echo "PR: $HEAD_BRANCH → $BASE_BRANCH"
          
          # Disallow: feature branch → infrastructure
          if [[ "$BASE_BRANCH" == "releases/b2b-infrastructure" ]] && [[ "$HEAD_BRANCH" == b2b-docs-* ]]; then
            echo "❌ INVALID: Feature branches cannot merge into infrastructure branch"
            echo "   Infrastructure changes should be made directly in infrastructure branch"
            exit 1
          fi
          
          # Disallow: docs-only → feature
          if [[ "$HEAD_BRANCH" == "releases/b2b-docs-only" ]] && [[ "$BASE_BRANCH" == b2b-docs-* ]]; then
            echo "❌ INVALID: Docs-only branch cannot merge into feature branches"
            echo "   Feature branches should base on docs-only, not merge from it"
            exit 1
          fi
          
          # Disallow: feature → feature (different drop-ins)
          if [[ "$BASE_BRANCH" == b2b-docs-* ]] && [[ "$HEAD_BRANCH" == b2b-docs-* ]] && [[ "$BASE_BRANCH" != "$HEAD_BRANCH" ]]; then
            echo "❌ INVALID: Feature branches cannot merge into other feature branches"
            exit 1
          fi
          
          echo "✅ Merge direction is valid"
      
      - name: Comment PR with validation results
        if: failure() && github.event_name == 'pull_request'
        uses: actions/github-script@v7
        with:
          script: |
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: '❌ **B2B Architecture Validation Failed**\n\nThis PR violates dual-branch architecture rules. Please review the workflow logs for details.\n\n📚 See [DUAL-BRANCH-ARCHITECTURE.md](../blob/develop/DUAL-BRANCH-ARCHITECTURE.md) for guidelines.'
            })

