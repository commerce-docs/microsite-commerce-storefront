---
import Dashboard from '@analytics/Dashboard';
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Analytics — Commerce Storefront Docs</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- Nav bar -->
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="home-link">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M15 18l-6-6 6-6" />
          </svg>
          Commerce Storefront Docs
        </a>
        <span class="header-title">Analytics</span>
      </div>
    </header>

    <!-- Dashboard (React island, fully client-side) -->
    <main class="main-content">
      <Dashboard client:only="react" />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <p>
        Data stored in Supabase. Visitor IDs are random UUIDs — no personal
        data is collected.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  /* ---- Reset & base ---- */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg: #f8f9fa;
    --bg-surface: #ffffff;
    --border: #e5e7eb;
    --text: #111827;
    --text-muted: #6b7280;
    --accent: #2563eb;
    --accent-hover: #1d4ed8;
    --badge-click-bg: #dbeafe;
    --badge-click-color: #1e40af;
    --badge-scroll-bg: #dcfce7;
    --badge-scroll-color: #166534;
    --badge-form-bg: #fef9c3;
    --badge-form-color: #854d0e;
    --badge-custom-bg: #f3e8ff;
    --badge-custom-color: #6b21a8;
    --badge-outcome-bg: #e0f2fe;
    --badge-outcome-color: #0369a1;
    --chart-grid: #e5e7eb;
    --chart-label: #9ca3af;
    --chart-tooltip-bg: #ffffff;
    --chart-line-1: #2563eb;
    --chart-line-2: #16a34a;
    --chart-line-3: #9333ea;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f172a;
      --bg-surface: #1e293b;
      --border: #334155;
      --text: #f1f5f9;
      --text-muted: #94a3b8;
      --accent: #60a5fa;
      --accent-hover: #93c5fd;
      --badge-click-bg: #1e3a5f;
      --badge-click-color: #93c5fd;
      --badge-scroll-bg: #14532d;
      --badge-scroll-color: #86efac;
      --badge-form-bg: #451a03;
      --badge-form-color: #fde047;
      --badge-custom-bg: #2e1065;
      --badge-custom-color: #d8b4fe;
      --badge-outcome-bg: #0c4a6e;
      --badge-outcome-color: #7dd3fc;
      --chart-grid: #334155;
      --chart-label: #64748b;
      --chart-tooltip-bg: #1e293b;
      --chart-line-1: #60a5fa;
      --chart-line-2: #4ade80;
      --chart-line-3: #c084fc;
    }
  }

  html,
  body {
    height: 100%;
    font-family:
      'Inter',
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    font-size: 15px;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  /* ---- Header ---- */
  .site-header {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .home-link {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    white-space: nowrap;
  }
  .home-link:hover {
    color: var(--text);
    text-decoration: none;
  }

  .header-title {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text);
  }

  /* ---- Main layout ---- */
  .main-content {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  /* ---- Footer ---- */
  .site-footer {
    text-align: center;
    padding: 1.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
  }

  /* ---- Dashboard container ---- */
  .dashboard-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* ---- Section headers ---- */
  .section-header {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text);
    margin-top: 1rem;
  }

  .section-intro {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: -0.5rem 0 0;
    max-width: 52rem;
    line-height: 1.5;
  }

  .muted {
    color: var(--text-muted);
  }

  /* ---- Summary cards ---- */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1rem;
  }

  /* Engagement row: slightly wider second column for the long label */
  .cards-grid--engagement {
    grid-template-columns: minmax(0, 1fr) minmax(10rem, 1.22fr) minmax(0, 1fr) minmax(0, 1fr);
  }

  .stat-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-label {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .stat-value {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--text);
  }

  .stat-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.125rem;
  }

  .loading-card {
    min-height: 96px;
    background: var(--border);
    animation: pulse 1.5s ease-in-out infinite;
  }

  /* ---- Chart ---- */
  .chart-wrapper {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem 0.5rem 0.75rem;
  }

  .chart-placeholder {
    height: 280px;
    border-radius: 10px;
    background: var(--border);
    animation: pulse 1.5s ease-in-out infinite;
  }

  /* ---- Tables ---- */
  .table-wrapper {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .data-table th {
    background: var(--bg);
    color: var(--text);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.625rem 1rem;
    text-align: left;
    vertical-align: middle;
    border-bottom: 1px solid var(--border);
  }

  .data-table th.num-col {
    text-align: right;
  }

  .data-table td {
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  .data-table tr:hover td {
    background: var(--bg);
  }

  .num-col {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .page-link {
    font-family: 'SFMono-Regular', Consolas, monospace;
    font-size: 0.8125rem;
  }

  /* ---- Event type badges ---- */
  .event-badge {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .event-badge--click {
    background: var(--badge-click-bg);
    color: var(--badge-click-color);
  }

  .event-badge--scroll {
    background: var(--badge-scroll-bg);
    color: var(--badge-scroll-color);
  }

  .event-badge--form {
    background: var(--badge-form-bg);
    color: var(--badge-form-color);
  }

  .event-badge--custom {
    background: var(--badge-custom-bg);
    color: var(--badge-custom-color);
  }

  .event-badge--outcome {
    background: var(--badge-outcome-bg);
    color: var(--badge-outcome-color);
  }

  /* ---- Loading & empty states ---- */
  .loading-placeholder {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .loading-row {
    height: 40px;
    border-radius: 6px;
    background: var(--border);
    animation: pulse 1.5s ease-in-out infinite;
  }

  .empty-state {
    color: var(--text-muted);
    font-size: 0.875rem;
    padding: 1rem 0;
  }

  .error-banner {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
    border-radius: 8px;
    padding: 0.875rem 1rem;
    font-size: 0.875rem;
  }

  .setup-notice {
    background: #fffbeb;
    border: 1px solid #fde68a;
    color: #92400e;
    border-radius: 8px;
    padding: 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .setup-notice code {
    background: rgba(0, 0, 0, 0.06);
    border-radius: 3px;
    padding: 0.125rem 0.25rem;
    font-family: 'SFMono-Regular', Consolas, monospace;
    font-size: 0.8125rem;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  @media (max-width: 640px) {
    .cards-grid {
      grid-template-columns: 1fr 1fr;
    }

    .cards-grid--engagement {
      grid-template-columns: 1fr 1fr;
    }

    .stat-value {
      font-size: 1.375rem;
    }

    .data-table th:nth-child(3),
    .data-table td:nth-child(3),
    .data-table th:nth-child(4),
    .data-table td:nth-child(4) {
      display: none;
    }
  }
</style>
