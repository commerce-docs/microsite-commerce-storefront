---
interface Props {
  label?: string; // Custom label for this specific option
}

const { label } = Astro.props;
---

<div class="ac-option" data-has-label={label ? "true" : "false"}>
  {label && <h3 class="ac-option-label">{label}</h3>}
  <slot />
</div>

<style is:global>
  .ac-option.ac-option {
    margin-top: 3rem;
    margin-bottom: 1rem;
    margin-left: -1.5rem;
    overflow-wrap: break-word;
    padding-left: 1rem;
    padding-right: 1rem;
    padding-bottom: 1rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.3rem;
    position: relative;
  }

  /* When using label prop, adjust border-top to align with label center */
  .ac-option.ac-option[data-has-label="true"] {
    margin-top: 3.5rem;
    padding-top: 0.5rem;
  }

  /* Label rendered from prop */
  .ac-option.ac-option > h3.ac-option-label {
    counter-increment: option;
    color: var(--sl-color-black);
    padding: 0.4rem 0.75rem;
    margin: 0;
    margin-left: -1.5rem;
    margin-bottom: -1rem;
    display: inline-block;
    border-radius: 0.2rem;
    min-width: 4rem;
    width: auto;
    line-height: 1.4;
    font-size: 1.25rem;
    background-color: hsl(224 90% 60% / 1);
    text-align: center;
    position: relative;
    top: -1.75rem;
    z-index: 1;
  }

  /* Numbered label - append counter */
  .ac-options:not([data-numbered="false"]) .ac-option.ac-option > h3.ac-option-label::after {
    content: " " counter(option);
  }

  /* Legacy support: h3 from content (not using label prop) */
  .ac-option.ac-option[data-has-label="false"] > h3 {
    counter-increment: option;
    color: var(--sl-color-gray-1);
    padding-left: 0;
    margin-bottom: 0.5rem;
    margin-top: -0.8rem;
    padding-top: 0;
    margin-left: -1.1rem;
    background-color: var(--sl-color-black);
    display: table;
    padding-right: 0.4rem;
  }

  .ac-option.ac-option[data-has-label="false"] > h3::before {
    content: var(--option-label, "Option") " " counter(option);
    border-radius: 0.2rem;
    display: inline-block;
    text-align: center;
    color: var(--sl-color-black);
    min-width: 4rem;
    width: auto;
    padding: 0.25rem 0.5rem 0.5rem 0.5rem;
    line-height: normal;
    font-size: 1.1rem;
    margin-left: -0.5rem;
    margin-top: 0;
    margin-right: 0.5rem;
    position: relative;
    background-color: var(--sl-color-accent);
  }

  /* Hide counter when numbering is disabled (legacy) */
  .ac-options[data-numbered="false"] .ac-option.ac-option[data-has-label="false"] > h3::before {
    content: var(--option-label, "Option");
  }

  /* Print-specific styles */
  @media print {
    .ac-option.ac-option {
      background-color: #fff;
      color: #000;
      border: none;
      page-break-after: always;
      page-break-inside: avoid;
    }

    .ac-option.ac-option > h3.ac-option-label {
      margin-top: 0;
      margin-bottom: 0.75rem;
    }

    .ac-option.ac-option[data-has-label="false"] > h3::before {
      content: var(--option-label, "Option") " " counter(option);
      border-radius: 0.2rem;
      display: inline-block;
      text-align: center;
      color: var(--sl-color-black);
      min-width: 4rem;
      width: auto;
      padding: 0 0.5rem;
      height: 1.5rem;
      line-height: normal;
      font-size: 1rem;
      margin-left: -1.5rem;
      margin-top: -2.75rem;
      margin-right: 0.5rem;
      position: relative;
      background-color: var(--sl-color-accent);
    }

    .ac-option.ac-option[data-has-label="false"] > h3 {
      margin-top: 0;
      margin-bottom: 0.75rem;
    }

    /* Hide counter when numbering is disabled (legacy print) */
    .ac-options[data-numbered="false"] .ac-option.ac-option[data-has-label="false"] > h3::before {
      content: var(--option-label, "Option");
    }
  }
</style>
