<div class="ac-option">
    <slot />
</div>

<style is:global>
    .ac-option.ac-option {
        margin-top: 0;
        margin-bottom: 1rem;
        margin-left: -1.5rem;
        overflow-wrap: break-word;
        padding-left: 1rem;
        padding-right: 1rem;
        padding-bottom: 1rem;
        border: 1px solid var(--sl-color-gray-4);
        border-radius: 0.3rem;
        margin-top: 3rem;
    }

    .ac-option.ac-option > h3 {
        counter-increment: option;
        color: var(--sl-color-gray-1);
        padding-left: 0;
        margin-bottom: 0.5rem;
        margin-top: -0.8rem;
        padding-top: 0;
        margin-left: -1.1rem;
        background-color: var(--sl-color-black);
        display: table;
        padding-right: 0.4rem;
    }

    .ac-option.ac-option > h3::before {
        content: "Option " counter(option);
        border-radius: 0.2rem;
        display: inline-block;
        text-align: center;
        color: var(--sl-color-black);
        width: 4rem;
        height: 1.5rem;
        line-height: normal;
        font-size: 1rem;
        margin-left: -0.5rem;
        margin-top: 0;
        margin-right: 0.5rem;
        position: relative;
        color: var(--sl-color-black);
        background-color: var(--sl-color-accent);
        vertical-align: text-top;
    }

    /* Print-specific styles */
    @media print {
        .ac-option.ac-option {
            background-color: #fff;
            color: #000;
            border: none;
            page-break-after: always;
            page-break-inside: avoid;
        }

        .ac-option.ac-option > h3::before {
            content: "Option " counter(option);
            border-radius: 0.2rem;
            display: inline-block;
            text-align: center;
            color: var(--sl-color-black);
            width: 4rem;
            height: 1.5rem;
            line-height: normal;
            font-size: 1rem;
            margin-left: -1.5rem;
            margin-top: -2.75rem;
            margin-right: 0.5rem;
            position: relative;
            color: var(--sl-color-black);
            background-color: var(--sl-color-accent);
        }
        .ac-option.ac-option > h3 {
            margin-top: 0;
            margin-bottom: 0.75rem;
        }
    }
</style>
