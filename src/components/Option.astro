---

---

<div class="ac-option">
  <slot />
</div>

<style is:global>
  .ac-options .ac-option.ac-option:last-child {
    margin-bottom: 0;
  }

  .ac-option.ac-option {
    margin-top: 3rem;
    margin-bottom: 0.5rem;
    margin-left: -1.5rem;
    overflow-wrap: break-word;
    padding-left: 1rem;
    padding-right: 1rem;
    padding-bottom: 0.5rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.3rem;
  }

  /* Reset sl-heading-wrapper margin when first child for consistent spacing */
  .ac-option.ac-option > .sl-heading-wrapper.level-h3:first-child {
    margin-top: 0;
    margin-bottom: 0;
  }

  /* Tighten the gap between the h3 title and the first h4 inside an option */
  .ac-option.ac-option .sl-heading-wrapper.level-h4,
  .ac-option.ac-option h4 {
    margin-top: 0.75rem;
  }

  /* Support both direct h3 (legacy) and Starlight's sl-heading-wrapper (post-update) */
  .ac-option.ac-option > h3,
  .ac-option.ac-option > .sl-heading-wrapper.level-h3 > h3 {
    counter-increment: option;
    color: var(--sl-color-gray-1);
    padding-left: 0;
    margin-bottom: 0.5rem;
    margin-top: -.75rem;
    padding-top: 0;
    margin-left: -1.1rem;
    background-color: var(--sl-color-black);
    display: inline-flex;
    vertical-align: middle;
  }

  .ac-option.ac-option > h3::before,
  .ac-option.ac-option > .sl-heading-wrapper.level-h3 > h3::before {
    content: var(--option-label, "Option") " " counter(option);
    border-radius: 0.2rem;
    display: inline-block;
    text-align: center;
    color: var(--sl-color-black);
    min-width: 5rem;
    width: auto;
    padding: 0.25rem 0.5rem 0.5rem 0.5rem;
    line-height: normal;
    font-size: 1.1rem;
    margin-left: -0.5rem;
    margin-top: -0.5rem;
    margin-right: 0.5rem;
    position: relative;
    color: var(--sl-color-black);
    background-color: var(--sl-color-accent);
  }

  /* Hide counter when numbering is disabled - same fixed width and padding for consistent spacing */
  .ac-options[data-numbered="false"] .ac-option.ac-option > h3::before,
  .ac-options[data-numbered="false"] .ac-option.ac-option > .sl-heading-wrapper.level-h3 > h3::before {
    content: var(--option-label, "Option");
    min-width: 5rem;
    width: auto;
    padding: 0.25rem 0.5rem 0.5rem 0.5rem;
  }

  /* Print-specific styles */
  @media print {
    .ac-option.ac-option {
      background-color: #fff;
      color: #000;
      border: none;
      page-break-after: always;
      page-break-inside: avoid;
    }

    .ac-option.ac-option > h3::before,
    .ac-option.ac-option > .sl-heading-wrapper.level-h3 > h3::before {
      content: var(--option-label, "Option") " " counter(option);
      border-radius: 0.2rem;
      display: inline-block;
      text-align: center;
      color: var(--sl-color-black);
      min-width: 5rem;
      width: 5rem;
      padding: 0 0.5rem;
      height: 1.5rem;
      line-height: normal;
      font-size: 1rem;
      margin-left: -1.5rem;
      margin-top: -2.75rem;
      margin-right: 0.5rem;
      position: relative;
      color: var(--sl-color-black);
      background-color: var(--sl-color-accent);
    }
    .ac-option.ac-option > h3,
    .ac-option.ac-option > .sl-heading-wrapper.level-h3 > h3 {
      margin-top: 0;
      margin-bottom: 0.75rem;
    }

    /* Hide counter when numbering is disabled - same fixed width for consistent spacing */
    .ac-options[data-numbered="false"] .ac-option.ac-option > h3::before,
    .ac-options[data-numbered="false"] .ac-option.ac-option > .sl-heading-wrapper.level-h3 > h3::before {
      content: var(--option-label, "Option");
      min-width: 5rem;
      width: 5rem;
    }
  }
</style>
