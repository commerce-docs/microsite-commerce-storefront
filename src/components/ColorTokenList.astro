---
export interface Props {
  tokens: Array<{ name: string; value: string; resolvedColor?: string }>;
}

const { tokens } = Astro.props;
---

<div class="color-token-list">
  {
    tokens.map(({ name, value, resolvedColor }) => (
      <div class="color-token-row">
        <code class="token-name">{name}</code>
        {resolvedColor && (
          <span
            class="color-swatch"
            style={`background-color: ${resolvedColor};`}
            title={resolvedColor}
          />
        )}
        <code class="token-value">{value}</code>
      </div>
    ))
  }
</div>

<style>
  .color-token-list {
    display: flex;
    flex-direction: column;
    margin: 1rem 0;
    font-family: var(--sl-font-mono);
    border-radius: 0.25rem;
    overflow: hidden;
  }

  .color-token-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.25rem 0.5rem;
    margin: 0 !important;
    background: var(--sl-color-gray-6);
  }

  .token-name {
    flex: 0 0 auto;
    min-width: 280px;
    color: var(--sl-color-white);
    font-size: 0.9em;
  }

  .color-swatch {
    display: inline-block;
    width: 18px;
    height: 18px;
    border-radius: 3px;
    border: 1px solid var(--sl-color-gray-4);
    flex-shrink: 0;
  }

  .token-value {
    color: var(--sl-color-gray-2);
    font-size: 0.9em;
  }
</style>
