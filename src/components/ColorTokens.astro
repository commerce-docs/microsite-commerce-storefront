---
export interface Props {
  tokens: Array<{ name: string; value: string }>;
}

const { tokens } = Astro.props;
---

<div class="color-tokens">
  {
    tokens.map(({ name, value }) => (
      <div class="color-token-row">
        <code class="color-token-name">{name}</code>
        {!value.startsWith("var(") && (
          <span
            class="color-swatch"
            style={`background-color: ${value};`}
            title={value}
          />
        )}
        <code class="color-token-value">{value}</code>
      </div>
    ))
  }
</div>

<style>
  .color-tokens {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    font-family: var(--sl-font-mono);
  }
  .color-token-row {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0;
    background: var(--sl-color-gray-7);
    border-radius: 0;
  }
  .color-token-name {
    flex: 0 0 auto;
    min-width: 280px;
    color: var(--sl-color-white);
    font-size: 0.9em;
  }
  .color-swatch {
    display: inline-block;
    width: 18px;
    height: 18px;
    border-radius: 3px;
    border: 1px solid var(--sl-color-gray-4);
    flex-shrink: 0;
  }
  .color-token-value {
    color: var(--sl-color-gray-2);
    font-size: 0.9em;
  }
</style>
