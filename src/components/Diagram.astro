---
const { caption, type = "image", code } = Astro.props;
const id = `diagram-${Math.random().toString(36).substring(2, 11)}`;
// Embed Mermaid text as JSON inside the markup — not in define:vars. Large or multiline
// sources break or bloat the hoisted module script; a broken module leaves "Loading…" forever.
const mermaidSourceJson =
  type === "mermaid" && code != null
    ? JSON.stringify(String(code))
        .replace(/</g, "\\u003c")   // prevent </script> from closing the JSON block
        .replace(/>/g, "\\u003e")   // prevent --> from being parsed as an HTML comment
        .replace(/&/g, "\\u0026")   // prevent &foo; sequences being decoded by HTML parser
    : "";
---

<div
  class="diagram"
  data-diagram-type={type}
  {...(type === "mermaid" ? { "data-pagefind-ignore": true } : {})}
>
  <div class="diagram-content">
    {type === "mermaid" ? (
      <div id={id} class="mermaid-diagram" data-pending-mermaid="true">
        {/*
          set:html is intentional: Astro's default child-expression escaping would double-escape
          the JSON (e.g. `"` → `&amp;quot;`), producing unreadable source. mermaidSourceJson is
          already sanitised above (< → \u003c) — no user-controlled HTML reaches this slot.
          Using <template> instead of <script type="application/json"> avoids confusing the
          Astro language server, which treats any <script> element in the template body specially.
        */}
        <template class="mermaid-diagram__source" set:html={mermaidSourceJson}></template>
        <div class="mermaid-loading">Loading diagram...</div>
      </div>
    ) : (
      <slot />
    )}
  </div>
  <div class="caption">{caption}</div>
</div>

<style is:global>
  .diagram {
    margin: 1rem 0;
    display: flex;
    flex-direction: column;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-4);
    box-shadow: var(--sl-shadow-sm);
    background-color: #fff;
  }

  .diagram-content {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    overflow-x: auto;
    max-height: 700px;
    position: relative;
  }

  .diagram.diagram > .diagram-content > p {
    margin: 0;
    font-size: 0;
    line-height: 0;
    width: 100%;
  }

  .diagram.diagram img {
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
  }

  .diagram.diagram > .diagram-content > p > img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(700px - 2rem);
    margin: 0 auto;
  }

  .diagram.diagram > .diagram-content > p > starlight-image-zoom-zoomable {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: calc(700px - 2rem);
    margin: 0 auto;
  }

  .diagram.diagram > .diagram-content > p > starlight-image-zoom-zoomable > img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(700px - 2rem);
    margin: 0 auto;
    object-fit: contain;
  }

  .caption.caption {
    font-size: 1rem;
    font-style: italic;
    line-height: normal;
    padding: 0.75rem;
    margin: 0;
    color: var(--sl-color-gray-2);
    background-color: var(--sl-color-gray-6);
    border-top: 1px solid var(--sl-color-gray-4);
  }

  @media screen and (max-width: 600px) {
    .caption.caption {
      padding: 0.15rem 0.5rem;
    }
  }

  /* Mermaid-specific styles */
  .mermaid-diagram {
    width: 100%;
    font-family: Arial, sans-serif;
  }

  /* starlight-image-zoom wraps the img in this element; keep it block and full-width. */
  .mermaid-diagram starlight-image-zoom-zoomable {
    display: block;
    width: 100%;
  }

  /* The entire content area is made clickable via a JS listener in mermaid-diagram.client.ts.
     Show zoom cursor so users know the whole area is interactive. */
  .diagram-content:has(.mermaid-diagram) {
    cursor: zoom-in;
  }

  /* <img> loaded from Blob URL — width 100% + height auto lets the SVG viewBox aspect ratio
     control the displayed height. Using <img> instead of inline <svg> avoids two zoom bugs:
     cloneNode(true) on <svg> duplicates <defs> marker IDs (arrows disappear in zoomed view),
     and the zoom plugin's natural-dimension logic treats <svg> as full-viewport-sized. */
  .mermaid-diagram img.mermaid-diagram__img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(700px - 2rem); /* subtract .diagram-content padding */
    margin: 0 auto;
    background-color: #fff;
    cursor: zoom-in;
  }

  .mermaid-loading {
    padding: 2rem;
    color: var(--sl-color-gray-2);
    font-style: italic;
  }

  .diagram-mermaid-error {
    padding: 1rem;
    border: 1px solid var(--sl-color-red);
    color: var(--sl-color-red);
    background-color: color-mix(in srgb, var(--sl-color-red) 8%, transparent);
  }

  @media print {
    .diagram.diagram {
      border: none;
      box-shadow: none;
      background-color: #fff;
    }
  }
</style>
