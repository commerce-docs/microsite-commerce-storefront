---
const { caption, width, type = "image", code } = Astro.props;
const id = `diagram-${Math.random().toString(36).substr(2, 9)}`;
// Embed Mermaid text as JSON inside the markup — not in define:vars. Large or multiline
// sources break or bloat the hoisted module script; a broken module leaves "Loading…" forever.
const mermaidSourceJson =
  type === "mermaid" && code != null
    ? JSON.stringify(String(code)).replace(/</g, "\\u003c")
    : "";
---

<div
  class="diagram"
  data-diagram-type={type}
  {...(type === "mermaid" ? { "data-pagefind-ignore": true } : {})}
>
  <div class="diagram-content">
    {type === "mermaid" ? (
      <div id={id} class="mermaid-diagram" data-pending-mermaid="true">
        {/*
          set:html is intentional: Astro's default child-expression escaping would double-escape
          the JSON (e.g. `"` → `&amp;quot;`), producing unreadable source. mermaidSourceJson is
          already sanitised above (</g, "\\u003c") — no user-controlled HTML reaches this slot.
        */}
        <script
          type="application/json"
          class="mermaid-diagram__source"
          set:html={mermaidSourceJson}
        />
        <div class="mermaid-loading">Loading diagram...</div>
      </div>
    ) : (
      <slot />
    )}
  </div>
  <div class="caption">{caption}</div>
</div>

<style define:vars={{ imageWidth: width }} is:global>
  .diagram {
    margin: 1rem 0;
    display: flex;
    flex-direction: column;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-4);
    box-shadow: var(--sl-shadow-sm);
    background-color: #fff;
  }

  .diagram-content {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    overflow: hidden;
  }

  .diagram.diagram > .diagram-content > p {
    margin: 0;
    font-size: 0;
    line-height: 0;
    width: 100%;
  }

  .diagram.diagram img {
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
  }

  .caption.caption {
    font-size: 1rem;
    font-style: italic;
    line-height: normal;
    padding: 0.75rem;
    margin: 0;
    color: var(--sl-color-gray-2);
    background-color: var(--sl-color-gray-6);
    border-top: 1px solid var(--sl-color-gray-4);
  }

  @media screen and (max-width: 600px) {
    .caption.caption {
      padding: 0.15rem 0.5rem;
    }
  }

  /* Mermaid-specific styles */
  .mermaid-diagram {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: Arial, sans-serif;
  }

  /*
    starlight-image-zoom: global `starlight-image-zoom-zoomable` is width 100%; the zoom control is
    `position: absolute` with top/left insets. On a full-width row the control sits in empty flex space
    and looks like a stray corner chip.

    Two rules also fight: `button:not(:focus)` (1px + clip) vs `.starlight-image-zoom-control` (44px,
    border, nav background) → a visible gray sliver. Shrink-wrap the zoomable and fully hide the
    unfocused control; zoom still opens from the image click once the plugin rescans.
  */
  .mermaid-diagram starlight-image-zoom-zoomable {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
  }

  .mermaid-diagram
    starlight-image-zoom-zoomable
    > button.starlight-image-zoom-control:not(:focus):not(:focus-within) {
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    clip: rect(0, 0, 0, 0) !important;
    height: 1px !important;
    margin: -1px !important;
    opacity: 0 !important;
    overflow: hidden !important;
    padding: 0 !important;
    width: 1px !important;
  }
  
  .mermaid-diagram svg {
    max-width: 100%;
    height: auto;
    display: block;
  }
  
  .mermaid-loading {
    padding: 2rem;
    color: var(--sl-color-gray-2);
    font-style: italic;
  }

  .diagram-mermaid-error {
    padding: 1rem;
    border: 1px solid var(--sl-color-red);
    color: var(--sl-color-red);
    background-color: color-mix(in srgb, var(--sl-color-red) 8%, transparent);
  }

  @media print {
    .diagram.diagram {
      border: none;
      box-shadow: none;
      background-color: #fff;
    }
  }

  :global(img[alt="Mermaid diagram"]) {
    background-color: white !important;
  }
</style>
