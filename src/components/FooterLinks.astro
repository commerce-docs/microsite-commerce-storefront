---
import { Icon } from '@astrojs/starlight/components';
---

<div class='wrapper'>
  <div class='socialLinks'>
    <a href='https://www.facebook.com/adobe' target='_blank' rel='noopener noreferrer' aria-label='Adobe on Facebook (opens in a new tab)'
      ><Icon name='facebook' size='1.25rem' /></a
    >
    <a href='https://www.instagram.com/adobe' target='_blank' rel='noopener noreferrer' aria-label='Adobe on Instagram (opens in a new tab)'
      ><Icon name='instagram' size='1.25rem' /></a
    >
    <a href='https://www.twitter.com/adobe' target='_blank' rel='noopener noreferrer' aria-label='Adobe on X (opens in a new tab)'
      ><Icon name='x.com' size='1.25rem' /></a
    >
    <a href='https://www.linkedin.com/company/adobe' target='_blank' rel='noopener noreferrer' aria-label='Adobe on LinkedIn (opens in a new tab)'
      ><Icon name='linkedin' size='1.25rem' /></a
    >
  </div>

  <div class='footerLinks'>
    <span class='copyright'>Copyright © 2026 Adobe. All rights reserved.</span>
    <div class='adobeLinks'>
      <a href='https://www.adobe.com/privacy.html' target='_blank' rel='noopener noreferrer' aria-label='Privacy (opens in a new tab)'>Privacy</a>
      <span aria-hidden='true'>/</span>
      <a href='https://www.adobe.com/legal/terms.html' target='_blank' rel='noopener noreferrer' aria-label='Terms of Use (opens in a new tab)'>Terms of Use</a>
      <span aria-hidden='true'>/</span>
      <a
        href='https://www.adobe.com/privacy/cookies.html'
        target='_blank'
        rel='noopener noreferrer'
        aria-label='Cookie policy (opens in a new tab)'
        >Cookie policy
      </a>
      <span aria-hidden='true'>/</span>
      <a href='https://www.adobe.com/privacy/us-rights.html' target='_blank' rel='noopener noreferrer' aria-label='Do not sell my personal information (opens in a new tab)'
        >Do not sell my personal information
      </a>
      <span aria-hidden='true'>/</span>
      <a href='https://www.adobe.com/privacy/opt-out.html#interest-based-ads' target='_blank' rel='noopener noreferrer' aria-label='AdChoices (opens in a new tab)'
        >AdChoices</a
      >
    </div>
  </div>
</div>

<style>
  .wrapper {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .footerLinks {
    display: block;
    min-width: 0;
    text-align: end;
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
    justify-items: end;
  }
  .adobeLinks {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    align-items: center;
    column-gap: 0.25rem;
  }
  .wrapper a {
    display: inline-flex;
    align-items: center;
    min-width: 24px;
    min-height: 24px;
  }
  .wrapper a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 3px;
  }
  .socialLinks a {
    color: var(--sl-color-text-accent);
  }
  .socialLinks {
    color: var(--sl-color-accent);
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    gap: 1rem;
  }

  @media (max-width: 49.999rem) {
    .wrapper {
      flex-direction: column;
    }
    .footerLinks {
      text-align: start;
    }
    .adobeLinks {
      justify-content: start;
    }
  }
</style>
