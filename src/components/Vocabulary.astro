---
interface Props {
  columns?: number;
}

const { columns = 1 } = Astro.props;
---

<div class="vocabularyContainer vocabulary">
  <slot />
</div>

<script>
  // Wrap each h3 and its following p in a div container
  document.addEventListener("DOMContentLoaded", () => {
    const vocabularyContainer = document.querySelector(".vocabularyContainer");
    if (!vocabularyContainer) return;

    const h3Elements = vocabularyContainer.querySelectorAll("h3");
    h3Elements.forEach((h3) => {
      const nextP = h3.nextElementSibling;
      if (nextP && nextP.tagName === "P") {
        const wrapper = document.createElement("div");
        wrapper.className = "vocabulary-item";
        h3.parentNode.insertBefore(wrapper, h3);
        wrapper.appendChild(h3);
        wrapper.appendChild(nextP);
      }
    });
  });
</script>

<style define:vars={{ columns }}>
  .vocabularyContainer {
    overflow-wrap: break-word;
    background-color: var(--sl-color-vocab);
    padding: 0.5rem;
    padding-top: 0.75rem;
    padding-right: 1rem;
    border-radius: 10px;
    margin-left: -0.25rem;
    column-count: var(--columns);
    column-gap: 1.5rem;
  }

  .vocabulary-item {
    break-inside: avoid-column;
    page-break-inside: avoid;
    margin-bottom: 0.5rem;
  }
  .vocabularyContainer :global(p) {
    margin-top: 0;
    margin-bottom: 0.25rem;
    margin-left: 2rem;
  }

  .vocabularyContainer :global(h3) {
    margin-top: 0.25rem;
    margin-bottom: 0.1rem;
    padding-top: unset;
  }

  .vocabulary :global(h3) {
    color: var(--sl-color-white);
    font-size: 1.1rem;
    font-weight: 700;
    margin-left: 0.25rem;
    margin-top: 1rem !important;
    margin-bottom: 0.1rem !important;
    break-inside: avoid-column;
  }

  .vocabulary :global(h3:first-child) {
    margin-top: 0 !important;
  }

  .vocabulary :global(h3::before) {
    display: inline-block;
    border-color: var(--sl-color-black);
    text-align: center;
    vertical-align: sub;
    content: url(/src/components/images/adobe.svg);
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 1rem;
    height: 0.75rem;
    width: 0.75rem;
    font-size: 1rem;
  }

  @media only screen and (max-width: 600px) {
    .vocabularyContainer {
      column-count: 1;
    }
  }

  /* .vocabulary > :global(h3::after) {
    display: inline-block;
    text-align: center;
    vertical-align: baseline;
    color: #147af3;
    content: '(noun)';
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0.35rem;
    font-weight: 400;
    font-style: italic;
    font-size: 13px;
  } */
</style>
