---
import { Code } from "@astrojs/starlight/components";
import convertDtsToJson from "@utils/convertDtsToJson";

export interface Props {
  code: string;
  lang?: string;
  meta?: string;
  locale?: string;
  title?: string;
  frame?: "none";
  mark?: string;
  ins?: string;
  del?: string;
  collapse?: string;
  collapsePreserveIndent?: true;
  showLineNumbers?: false;
  startLineNumber?: 1;
  wrap?: false;
  preserveIndent?: true;
}

const props = Astro.props;
const cleanJson = convertDtsToJson(props.code);
Astro.props.code = cleanJson || props.code;
---

<div id="code-block" class="code-block">
  <Code {...props} />
</div>

<style>
  .code-block {
    margin: 0;
    border-radius: 3px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
  }

  /* Fix for double line spacing issue in large code blocks */
  .code-block :global(.expressive-code .ec-line) {
    display: flex !important;
    align-items: flex-start !important;
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1.4 !important;
    min-height: auto !important;
  }

  /* Hide line numbers completely */
  .code-block :global(.expressive-code .frame) {
    --lnWidth: 0ch !important;
  }

  .code-block :global(.expressive-code .ec-line .gutter),
  .code-block :global(.expressive-code .gutter),
  .code-block :global(.expressive-code .ln) {
    display: none !important;
    width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .code-block :global(.expressive-code .code) {
    flex: 1 !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Hide copy button since it's not working properly */
  .code-block :global(.expressive-code .copy) {
    display: none !important;
  }
</style>
