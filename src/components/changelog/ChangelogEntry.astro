---
interface Props {
  date: string;
  title: string;
  components: string[];
}

const { date, title, components } = Astro.props;

// Parse the date as local time to avoid timezone issues
const [year, month, day] = date.split('-').map(Number);
const dateObj = new Date(year, month - 1, day); // month is 0-indexed in Date constructor

const formattedDate = dateObj.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Slugify the title and pair it with the date so entries that share a title
// (for example, repeated "Boilerplate Updates" releases) still get a unique anchor.
const titleSlug = title
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '');
const id = `${titleSlug}-${date}`;
---

<article class="changelog-entry" data-components={components.join(',')}>
  <div class="entry-header">
    <div class="entry-meta">
      <time datetime={date}>{formattedDate}</time>
    </div>
    <div class="sl-heading-wrapper level-h2"
      ><h2 id={id} class="entry-title">{title}</h2><a class="sl-anchor-link" href={`#${id}`}
        ><span aria-hidden="true" class="sl-anchor-icon"
          ><svg width="16" height="16" viewBox="0 0 24 24"
            ><path
              fill="currentcolor"
              d="m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 0 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 1 0-1.42-1.42Zm8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 0 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 1 0 1.42 1.42l3.88-3.89a4.49 4.49 0 0 0 0-6.33ZM8.83 15.17a1 1 0 0 0 1.1.22 1 1 0 0 0 .32-.22l4.92-4.92a1 1 0 0 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42Z"
            ></path></svg
          ></span
        ><span class="sr-only" data-pagefind-ignore="" set:text={`Section titled “${title}”`} /></a
      ></div
    >
    <div class="entry-tags">
      {components.map(component => {
        return <span class="entry-tag">{component}</span>;
      })}
    </div>
  </div>
  <div class="entry-content">
    <slot />
  </div>
</article>