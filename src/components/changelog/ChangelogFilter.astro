---
const allComponents = [
  'Boilerplate',
  'Cart',
  'Checkout',
  'Company Management',
  'Company Switcher',
  'Drop-in SDK',
  'Order',
  'Payment Services',
  'Personalization',
  'Product Details Page',
  'Product Discovery',
  'Product Recommendations',
  'Purchase Order',
  'Quick Order',
  'Quote Management',
  'Requisition List',
  'Storefront Compatibility Package',
  'Storefront Compatibility B2B Package',
  'User Account',
  'User Authentication',
  'Wishlist'
];
---

<div class="changelog-filter">
  <label for="component-filter" class="changelog-filter__label">Filter</label>
  <select id="component-filter" class="filter-select" aria-label="Filter by drop-in component">
    <option value="">All components</option>
    {allComponents.map(component => (
      <option value={component}>{component}</option>
    ))}
  </select>
</div>

<p id="no-entries-message" class="no-entries-message" hidden>
  A changelog for that component does not exist.
</p>

<script is:inline>
  (function () {
    function run() {
      const select = document.getElementById('component-filter');
      const message = document.getElementById('no-entries-message');
      if (!select || !message || select.dataset.initialized === 'true') return;

      function filter() {
        const value = select.value;
        let visible = 0;
        for (const entry of document.querySelectorAll('.changelog-entry')) {
          const attr = entry.getAttribute('data-components');
          if (!attr) continue;
          const match = !value || attr.split(',').map((c) => c.trim()).includes(value);
          if (entry instanceof HTMLElement) {
            entry.style.display = match ? '' : 'none';
            if (match) visible++;
          }
        }
        message.hidden = !value || visible > 0;
      }

      function applyHashFilter() {
        const id = window.location.hash.slice(1);
        if (!id) return;
        const heading = document.getElementById(id);
        const entry = heading && heading.closest('.changelog-entry');
        const attr = entry && entry.getAttribute('data-components');
        if (!attr) return;

        const component = attr.split(',')[0].trim();
        if (select.value !== component) {
          select.value = component;
          filter();
        }
        entry.scrollIntoView();
      }

      select.addEventListener('change', filter);
      select.dataset.initialized = 'true';
      filter();
      applyHashFilter();
      window.addEventListener('hashchange', applyHashFilter);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }
    document.addEventListener('astro:page-load', () => setTimeout(run, 100));
  })();
</script>
