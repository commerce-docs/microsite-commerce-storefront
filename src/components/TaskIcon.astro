---
/**
 * Marks a heading as an author task. Place it at the start of a heading; the icon
 * hangs in the left margin next to the text without changing the auto-generated
 * anchor or the "On this page" table of contents (the icon renders no text and is
 * aria-hidden):
 *
 *   ## <TaskIcon /> Preview a product
 *
 * Pass `icon` to override the default glyph.
 */
import Icon from '@components/overrides/Icon.astro';
import { Icons } from '@components/overrides/Icons';

interface Props {
  icon?: keyof typeof Icons;
  size?: string;
}

const { icon = 'rocket', size = '1.4rem' } = Astro.props as Props;
---

<Icon name={icon} size={size} color="var(--sl-color-accent)" class="task-icon" />

<style is:global>
  .sl-markdown-content :is(h1, h2, h3, h4):has(.task-icon) {
    position: relative;
  }
  .sl-markdown-content :is(h1, h2, h3, h4) .task-icon {
    position: absolute;
    right: 100%;
    margin-right: 0.5rem;
  }
</style>
