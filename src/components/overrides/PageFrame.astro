---
import type { Props } from "@astrojs/starlight/props";
import MobileMenuToggle from "virtual:starlight/components/MobileMenuToggle";
import CascadingExpansion from "../CascadingExpansion.astro";

const { hasSidebar, entry } = Astro.props;
// Compute splash from entry frontmatter; fall back to locals entry in prod
const routeEntry = entry ?? Astro.locals?.starlightRoute?.entry;
const isSplash = routeEntry?.data?.template === "splash";
---

<div class:list={["page", "sl-flex", { "splash-page": isSplash }]}>
  <a href="#_top" class="skip-link">Skip to content</a>
  <header class="header"><slot name="header" /></header>
  {
    hasSidebar && (
      <nav
        class="sidebar"
        aria-label={Astro.locals.t(["sidebarNav.accessibleLabel"])}
      >
        <MobileMenuToggle {...Astro.props} />
        <div id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
          </div>
        </div>
      </nav>
    )
  }
  <div class="main-frame"><slot /></div>
</div>

<!-- Add cascading expansion feature when sidebar is present -->
{hasSidebar && <CascadingExpansion />}

<style>
  .page {
    flex-direction: column;
    min-height: 100vh;
  }
  .skip-link {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: -3rem;
    z-index: 1000;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    padding: 0.5rem 1rem;
    border-radius: 0 0.25rem 0.25rem 0;
    text-decoration: none;
  }
  .skip-link:focus {
    inset-block-start: 0;
  }

  /* Full-page gradient background for splash pages */
  .splash-page {
    background: linear-gradient(
      135deg,
      hsl(240deg 90% 15%) 0%,
      hsl(260deg 85% 18%) 25%,
      hsl(280deg 80% 22%) 50%,
      hsl(300deg 75% 25%) 75%,
      hsl(320deg 70% 28%) 100%
    );
  }

  .page.splash-page .main-frame {
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 1;
    width: 100%;
  }

  .header {
    z-index: var(--sl-z-index-navbar);
    position: fixed;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: 100%;
    height: var(--sl-nav-height);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    padding-inline-end: var(--sl-nav-pad-x);
    background-color: var(--sl-color-bg-nav);
  }

  /* Make header transparent for splash pages */
  .splash-page .header {
    background-color: transparent;
    border-bottom: none;
  }

  :global([data-has-sidebar]) .header {
    padding-inline-end: calc(
      var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)
    );
  }

  .sidebar-pane {
    visibility: var(--sl-sidebar-visibility, hidden);
    position: fixed;
    z-index: var(--sl-z-index-menu);
    inset-block: var(--sl-nav-height) 0;
    inset-inline-start: 0;
    width: 100%;
    background-color: var(--sl-color-black);
    overflow-y: auto;
  }

  :global([aria-expanded="true"]) ~ .sidebar-pane {
    --sl-sidebar-visibility: visible;
  }

  .sidebar-content {
    height: 100%;
    min-height: max-content;
    padding: 1rem var(--sl-sidebar-pad-x) 0;
    padding-top: 0.75rem;
    flex-direction: column;
    gap: 1rem;
  }

  .main-frame {
    padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
    padding-inline-start: var(--sl-content-inline-start);
  }

  @media (min-width: 50rem) {
    .sidebar-content::after {
      content: "";
      padding-bottom: 1px;
    }
    :global([data-has-sidebar]) .header {
      padding-inline-end: var(--sl-nav-pad-x);
    }
    .sidebar-pane {
      --sl-sidebar-visibility: visible;
      width: var(--sl-sidebar-width);
      background-color: var(--sl-color-bg-sidebar);
      border-inline-end: 1px solid var(--sl-color-hairline-shade);
    }
  }
</style>
