---
import { PAGE_TITLE_ID } from "../constants";
import type { Props } from "@astrojs/starlight/props";
import CallToAction from "./CallToAction.astro";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, subtitle, tagline, actions = [] } = data.hero || {};
const isSplash = data.template === "splash";
---

<div class:list={["hero", { "hero-splash": isSplash }]}>
  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
      {subtitle && <div class="subtitle" set:html={subtitle} />}
      {tagline && <div class="tagline" set:html={tagline} />}
    </div>
    {
      actions.length > 0 && (
        <div class="sl-flex actions">
          {actions.map(
            ({ text, ...attrs }: { text: string; [key: string]: any }) => (
              <CallToAction
                {...attrs}
                variant={attrs.variant}
                link={attrs.link}
                set:html={text}
              />
            )
          )}
        </div>
      )
    }
  </div>
</div>

<style>
  .hero {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: clamp(2rem, 6vw, 4rem) 2rem;
    text-wrap: pretty;
    width: 100%;
  }

  /* Gradient animation */
  @keyframes gradientFade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Full viewport splash background */
  .hero-splash::before {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    animation: gradientFade 0.3s ease-out;

    /* Light mode: colorful gradient without yellow */
    background: linear-gradient(
      135deg,
      hsl(240deg 85% 82%) 0%,
      hsl(260deg 80% 84%) 20%,
      hsl(280deg 75% 86%) 40%,
      hsl(300deg 80% 85%) 60%,
      hsl(320deg 85% 83%) 80%,
      hsl(340deg 90% 80%) 100%
    );
  }

  /* Dark mode using Starlight's theme system */
  :global(html[data-theme="dark"]) .hero-splash::before {
    background: linear-gradient(
      135deg,
      hsl(240deg 90% 15%) 0%,
      hsl(260deg 85% 18%) 25%,
      hsl(280deg 80% 22%) 50%,
      hsl(300deg 75% 25%) 75%,
      hsl(320deg 70% 28%) 100%
    ) !important;
  }

  .hero .stack {
    flex-direction: column;
    gap: 2rem;
    text-align: center;
    align-items: center;
    max-width: 900px;
    width: 100%;
    margin: 0 auto;
  }

  .hero .copy {
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
    width: 100%;
    text-align: center;
  }

  .hero .copy > * {
    max-width: 65ch;
    margin: 0 auto;
    text-align: center;
  }

  /* Stagger animation keyframes */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Disable animations on mobile for performance */
  @media (max-width: 50rem) {
    .hero-splash::before {
      animation: none;
    }
  }

  /* Respect reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .hero-splash::before {
      animation: none;
    }
    .hero h1,
    .hero .subtitle,
    .hero .tagline,
    .hero .actions {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    font-weight: 900;
    color: #1a1a1a;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  /* Only animate on larger screens to avoid blocking LCP on mobile */
  @media (min-width: 50rem) {
    h1 {
      animation: fadeInUp 0.3s ease-out forwards;
      opacity: 0;
    }
  }

  .subtitle {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.3;
    font-weight: 200;
    color: #1a1a1a;
    letter-spacing: 0.02em;
  }

  .tagline {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.6;
    color: #2a2a2a;
    max-width: 60ch;
    text-wrap: balance;
    font-weight: 400;
  }

  /* Only animate on larger screens */
  @media (min-width: 50rem) {
    .subtitle {
      animation: fadeInUp 0.3s ease-out 0.06s forwards;
      opacity: 0;
    }
    .tagline {
      animation: fadeInUp 0.3s ease-out 0.12s forwards;
      opacity: 0;
    }
  }

  /* Dark mode text colors - Starlight theme system */
  :global(html[data-theme="dark"]) .hero h1 {
    color: #ffffff !important;
  }

  :global(html[data-theme="dark"]) .hero .subtitle {
    color: #ffffff !important;
  }

  :global(html[data-theme="dark"]) .hero .tagline {
    color: rgba(255, 255, 255, 0.95) !important;
  }

  .hero .actions {
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.5rem;
  }

  /* Only animate on larger screens */
  @media (min-width: 50rem) {
    .hero .actions {
      animation: fadeInUp 0.3s ease-out 0.18s forwards;
      opacity: 0;
    }
  }

  @media (max-width: 50rem) {
    .hero {
      min-height: 50vh;
      padding: clamp(2rem, 6vw, 3rem) 1rem;
    }

    h1 {
      font-size: clamp(1.75rem, 6vw, 2.5rem);
    }

    .subtitle {
      font-size: clamp(1.25rem, 4vw, 1.75rem);
    }

    .tagline {
      font-size: clamp(1rem, 3vw, 1.25rem);
    }
  }
</style>
