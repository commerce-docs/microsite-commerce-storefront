---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import ImageZoom from 'starlight-image-zoom/components/ImageZoom.astro';
import RecentSearches from '../RecentSearches.astro';

const slug = Astro.locals.starlightRoute?.entry?.slug ?? '';

// Developer drop-in docs, release/update pages, and merchant block overview pages
// accumulate high body-content term frequency that overwhelms shorter, focused
// merchant block pages in search. Reducing their body weight keeps them findable
// by their page titles (h1 is unaffected) but stops incidental term repetition
// from outranking dedicated merchant topic pages for queries like "create company".
// The b2b/b2c merchant index pages are comprehensive listing pages — they reference
// every block by name, so they shouldn't outrank the specific pages they list.
//
// v1 approach: explicit slug list. Auditable and predictable, but requires a
// manual update when new high-volume index pages are added. A future improvement
// would be a per-page frontmatter flag (e.g. pagefindWeight: 0.1) so content
// authors can control this without touching component code.
const isHighVolumeIndex =
  slug === 'releases' || slug.startsWith('releases/') ||
  slug === 'boilerplate/updates' ||
  slug === 'dropins-b2b' || slug.startsWith('dropins-b2b/') ||
  slug === 'merchants/blocks/b2b' ||
  slug === 'merchants/blocks/b2c' ||
  slug.startsWith('licensing/') ||
  slug === 'dropins/all/creating';
---

{/*
  When MarkdownContent is overridden, the zoom plugin does not inject ImageZoom automatically;
  include it explicitly so `<starlight-image-zoom>` exists (needed for Mermaid diagrams and
  markdown image zoom).
  TODO: If starlight-image-zoom ever injects ImageZoom even when MarkdownContent is overridden
  (tracked upstream), remove this explicit inclusion to avoid double-registration.
  Ref: https://github.com/HiDeoo/starlight-image-zoom
*/}
<ImageZoom />
<RecentSearches />

{
  isHighVolumeIndex ? (
    <div data-pagefind-weight="0.1">
      <Default {...Astro.props}>
        <slot />
      </Default>
    </div>
  ) : (
    <Default {...Astro.props}>
      <slot />
    </Default>
  )
}
