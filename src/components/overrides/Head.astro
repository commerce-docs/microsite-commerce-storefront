---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
import '../../fonts/font-face.css';
import regularFont from '../../fonts/adobe-clean-400.woff2?url';
import boldFont from '../../fonts/adobe-clean-700.woff2?url';
import blackFont from '../../fonts/adobe-clean-900.woff2?url';

const isHomePage =
  Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const homeFonts = [regularFont, boldFont];
---

<DefaultHead {...Astro.props} />
<link rel='preload' href={blackFont} as='font' type='font/woff2' crossorigin='anonymous' />
{
  isHomePage &&
    homeFonts.map((href) => (
      <link rel='preload' href={href} as='font' type='font/woff2' crossorigin='anonymous' />
    ))
}
