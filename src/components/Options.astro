---
interface Props {
  label?: string; // Customize the label (e.g., "Strategy", "Approach", etc.)
  numbered?: boolean; // Show numbers (default: true)
}

const { label = "Option", numbered = true } = Astro.props;
---

<div
  class="ac-options"
  style={`--option-label: "${label}"`}
  data-numbered={numbered}
>
  <slot />
</div>

<style is:global>
  .ac-options.ac-options {
    counter-reset: option;
    padding-left: 1.5rem;
    margin-left: 0.35rem;
    margin-top: -1rem;
  }

  @media print {
    .ac-options.ac-options {
      padding-left: 0;
    }
  }
</style>
