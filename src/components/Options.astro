---
interface Props {
  label?: string; // Customize the label (e.g., "Strategy", "Approach", etc.)
}

const { label = "Option" } = Astro.props;
---

<div class="ac-options" style={`--option-label: "${label}"`}>
  <slot />
</div>

<style is:global>
  .ac-options.ac-options {
    counter-reset: option;
    padding-left: 1.5rem;
    margin-left: 0.35rem;
    margin-top: -1rem;
  }

  @media print {
    .ac-options.ac-options {
      padding-left: 0;
    }
  }
</style>
