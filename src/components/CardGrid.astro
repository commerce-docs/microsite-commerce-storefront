---
interface Props {
  stagger?: boolean;
}

const { stagger = false } = Astro.props;
---

<div class:list={["card-grid", { stagger }]}><slot /></div>

<style is:global>
  .card-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 50rem) {
    .card-grid.card-grid {
      grid-template-columns: 1fr 1fr;
      margin-top: 1.5rem;
    }
    .stagger {
      --stagger-height: 5rem;
      padding-bottom: var(--stagger-height);
    }

    .stagger > :global(*) {
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        background-color 0.3s ease;
    }

    .stagger > :global(*):nth-child(2n) {
      transform: translateY(var(--stagger-height));
    }

    .stagger > :global(.sl-link-card:hover):nth-child(2n),
    .stagger > :global(.sl-link-card:has(a:hover)):nth-child(2n) {
      transform: translateY(calc(var(--stagger-height) - 6px));
    }
  }
</style>
