+**Activation Logic:**
+```javascript
+// Only generate for blocks with multiple boolean/toggle configs or URLs
+const toggleConfigs = configs.filter(c => 
+    c.type === 'boolean' || 
+    c.key.includes('enable') || 
+    c.key.includes('hide') ||
+    c.key.includes('show')
+);
+
+const urlConfigs = configs.filter(c => 
+    c.key.includes('url') || c.key.includes('path')
+);
