+            const variable = propMatch[2].trim();
+            let defaultValue = propMatch[3]?.trim() || 'undefined';
+
+            // Clean up default value
+            defaultValue = defaultValue
+                .replace(/^['"`]|['"`]$/g, '')
+                .replace(/,\s*$/, '')
+                .trim();
