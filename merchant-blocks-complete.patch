+            configs.push({
+                key: key,
+                variable: variable,
+                type: type,
+                default: defaultValue,
+                description: '', // Will be enriched from README
+                required: 'No',
+                sideEffects: '',
+                source: 'source-code'
+            });
+        }
+    }
+
+    return configs;
